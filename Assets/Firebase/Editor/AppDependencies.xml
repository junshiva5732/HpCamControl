<dependencies>
    <remoteSwiftPackage url="https://github.com/firebase/firebase-ios-sdk.git" version="12.17.0">
        <swiftPackage name="FirebaseCore" replacesPod="Firebase/Core"/>
    </remoteSwiftPackage>
    <iosPods>
