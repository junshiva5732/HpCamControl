        <androidPackage spec="com.google.firebase:firebase-common:20.4.3">
        </androidPackage>
        <androidPackage spec="com.google.firebase:firebase-analytics:21.5.1">
        </androidPackage>
        <androidPackage spec="com.google.android.gms:play-services-base:18.3.0">
        </androidPackage>
        <androidPackage spec="com.google.firebase:firebase-app-unity:13.15.0">
